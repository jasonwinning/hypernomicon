<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25"
            fx:controller="org.hypernomicon.testTools.WebButtonsTestCtrlr">
  <Label text="Context:" AnchorPane.leftAnchor="14.0" AnchorPane.topAnchor="10.0"/>
  <ComboBox fx:id="cbWebBtnContext" prefWidth="260.0" AnchorPane.leftAnchor="75.0" AnchorPane.topAnchor="7.0"/>
  <Label text="Every button offered in Settings for the context, including custom ones. Open opens it in the system browser with the sample values on the right; blank a value to try a fallback pattern."
         wrapText="true" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="38.0"/>
  <SplitPane dividerPositions="0.5" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="14.0"
             AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="78.0">
    <TableView fx:id="tvWebBtnPresets">
      <columns>
        <TableColumn fx:id="colWebBtnName" prefWidth="160.0" text="Button"/>
        <TableColumn fx:id="colWebBtnCaption" prefWidth="85.0" text="Caption"/>
        <TableColumn fx:id="colWebBtnPatterns" prefWidth="60.0" text="Patterns"/>
      </columns>
    </TableView>
    <ScrollPane fitToWidth="true">
      <GridPane fx:id="gpWebBtnFields" hgap="8.0" vgap="6.0">
        <padding>
          <Insets bottom="6.0" left="6.0" right="6.0" top="6.0"/>
        </padding>
      </GridPane>
    </ScrollPane>
  </SplitPane>
  <Button mnemonicParsing="false" onAction="#btnWebBtnOpenClick" prefHeight="25.0" text="Open selected"
          AnchorPane.bottomAnchor="46.0" AnchorPane.leftAnchor="14.0"/>
  <Button mnemonicParsing="false" onAction="#btnWebBtnOpenAllClick" prefHeight="25.0" text="Open all"
          AnchorPane.bottomAnchor="46.0" AnchorPane.leftAnchor="130.0"/>
  <Label text="Last URL:" AnchorPane.bottomAnchor="17.0" AnchorPane.leftAnchor="14.0"/>
  <TextField fx:id="tfWebBtnLastUrl" editable="false" maxHeight="25.0" minHeight="25.0" prefHeight="25.0"
             AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="14.0"/>
</AnchorPane>
